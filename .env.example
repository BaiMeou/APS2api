# ── Vertex AI Proxy 环境变量 ──────────────────────────────────────────────────

# 出站代理（可选）
# 填写后所有到 Vertex AI 的请求都会经过此代理
# 支持 HTTP / SOCKS5
PROXY_URL=
# PROXY_URL=socks5://127.0.0.1:7890
# PROXY_URL=http://user:pass@proxy.example.com:3128

# 映射到宿主机的端口（默认 2156）
PORT=2156

# 管理员密码（可选）
# 设置后管理面板以此密码登录；留空则首次启动自动生成并打印到日志
# 设置后无法在面板中修改密码（仅能通过环境变量更新）
# ADMIN_PASSWORD=

# Worker 二进制文件缓存目录（可选）
# 默认使用系统临时目录；自定义路径可用于持久化已下载的 worker 二进制文件
# WORKER_BIN_DIR=/app/bin
